-- Animation manager
local AnimationManager = {
	tracks = {},
	loaded = {},
	playingState = nil,
}
function AnimationManager:loadAnim(name, id)
	if not animator or id == 0 or id == nil or tostring(id) == "" then return end
	-- stop previous track for this name
	if self.loaded[name] and self.loaded[name].Track then
		pcall(function() self.loaded[name].Track:Stop() end)
		self.loaded[name] = nil
	end
	local success, anim = pcall(function()
		local a = Instance.new("Animation")
		a.Name = "DeathClient_"..name
		a.AnimationId = "rbxassetid://"..tostring(id)
		return a
	end)
	if success and anim then
		local ok, track = pcall(function() return animator:LoadAnimation(anim) end)
		if ok and track then
			track.Priority = Enum.AnimationPriority.Movement
			self.loaded[name] = { AnimObj = anim, Track = track }
		end
	end
end
function AnimationManager:play(name, speed)
	if not self.loaded[name] then return end
	speed = speed or config.normal.animation.playSpeed
	-- stop others
	for n, tbl in pairs(self.loaded) do
		if tbl.Track and n ~= name then
			pcall(function() tbl.Track:Stop() end)
		end
	end
	local ok, _ = pcall(function()
		local t = self.loaded[name].Track
		t:Play(0.15)
		t:AdjustSpeed(speed)
	end)
	if ok then self.playingState = name end
end
function AnimationManager:stopAll()
	for _,tbl in pairs(self.loaded) do
		if tbl.Track then pcall(function() tbl.Track:Stop() end) end
	end
	self.playingState = nil
end
function AnimationManager:preview(name)
	-- quick single-play preview
	if not self.loaded[name] then return end
	pcall(function()
		local t = self.loaded[name].Track
		t:Play()
		delay(1.2, function() pcall(function() t:Stop() end) end)
	end)
end

-- ---------- UTIL ----------
local function safeParent(obj, parent)
	pcall(function() obj.Parent = parent end)
end
local function keyName(k) return (k and tostring(k):gsub("Enum.KeyCode.","")) or "-" end
local function tobool(v)
	if type(v)=="boolean" then return v end
	if type(v)=="string" then local s=v:lower(); return s=="true" or s=="1" or s=="yes" end
	if type(v)=="number" then return v~=0 end
	return false
end
local function parseNumber(s, fallback) local n = tonumber(s) return n or fallback end

-- ---------- PERSISTENT GUI (create container) ----------
local function createBaseGui()
	local sg = Instance.new("ScreenGui")
	sg.Name = "DeathClientMenu_v"..config.version
	sg.ResetOnSpawn = false
	safeParent(sg, guiParent)
	-- UIScale for theme
	local us = Instance.new("UIScale", sg)
	us.Name = "UIScale"
	us.Scale = config.theme.uiScale or 1
	return sg
end

